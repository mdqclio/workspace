+            <th style="padding:6px;color:var(--text3);font-size:11px;font-weight:500;text-align:center;">BASE</th>
+            <th style="padding:6px;color:var(--text3);font-size:11px;font-weight:500;text-align:center;">SCORE</th>
+          </tr>
